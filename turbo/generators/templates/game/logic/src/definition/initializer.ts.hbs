import {
    BaseGameInitializer,
    HydratedTurnManager,
    Prng,
    shuffle,
    type Game,
    type GameInitializer,
    type Player,
    type StartingPositionAssignment,
    type UninitializedGameState
} from '@tabletop/common'
import {
    CURRENT_{{constantCase game}}_REVISION,
    Hydrated{{properCase game}}GameState,
    type {{properCase game}}GameState
} from '../model/gameState.js'
import { Hydrated{{properCase game}}PlayerState, type {{properCase game}}PlayerState } from '../model/playerState.js'
import { {{properCase game}}Colors } from './colors.js'
import { MachineState } from './states.js'

export class {{properCase game}}GameInitializer
    extends BaseGameInitializer<{{properCase game}}GameState, Hydrated{{properCase game}}GameState>
    implements GameInitializer<{{properCase game}}GameState, Hydrated{{properCase game}}GameState>
{
    readonly supportsStartingPositions = true

    initializeGameState(
        game: Game,
        state: UninitializedGameState,
        assignment?: StartingPositionAssignment
    ): Hydrated{{properCase game}}GameState {
        const prng = new Prng(state.prng)
        const players = this.initializePlayers(game, prng)
        const turnManager = HydratedTurnManager.generate(players, prng.random, assignment)
        const orderedPlayers = turnManager.turnOrder.map((playerId) =>
            players.find((player) => player.playerId === playerId)
        ).filter((player): player is {{properCase game}}PlayerState => player !== undefined)

        const {{camelCase game}}GameState: {{properCase game}}GameState = Object.assign(state, {
            players: orderedPlayers,
            machineState: MachineState.StartOfTurn,
            turnManager,
            {{camelCase game}}Revision: CURRENT_{{constantCase game}}_REVISION
        })

        return new Hydrated{{properCase game}}GameState({{camelCase game}}GameState)
    }

    private initializePlayers(game: Game, prng: Prng): {{properCase game}}PlayerState[] {
        const colors = [...{{properCase game}}Colors]
        shuffle(colors, prng.random)

        return game.players.map(
            (player: Player, index: number) =>
                new Hydrated{{properCase game}}PlayerState({
                    playerId: player.id,
                    color: colors[index]
                })
        )
    }
}
